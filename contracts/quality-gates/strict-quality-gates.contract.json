{
  "schemaVersion": 1,
  "asOf": "2026-06-12",
  "purpose": "Define strict CI, code quality, coverage, versioning, and validation gates for every public library, package, and language surface without claiming proprietary-runtime execution where no runtime is available.",
  "minimumCoveragePercent": 90,
  "requiredGateClasses": [
    "unit",
    "integration",
    "end_to_end",
    "smoke",
    "edge",
    "property_based",
    "mutation",
    "profiling",
    "load_or_load_balancing",
    "security",
    "versioning"
  ],
  "globalCriteria": {
    "coverage": {
      "thresholdPercent": 90,
      "pythonGate": ".github/workflows/pr-ci.yml coverage job and .github/workflows/coverage.yml python_coverage job use --cov-fail-under=90.",
      "rustGate": ".github/workflows/rust-ci.yml and .github/workflows/coverage.yml enforce >=90% coverage for nwau-core."
    },
    "quality": {
      "python": "ruff format --check, ruff check, docstring lint, ty --error all",
      "rust": "cargo fmt --check, cargo clippy -D warnings, cargo doc with RUSTDOCFLAGS=-D warnings",
      "security": "bandit, pip-audit, cargo audit, cargo deny, CodeQL, Trivy high/critical scan"
    },
    "dependencyAutomation": {
      "renovate": "renovate.json covers Python, GitHub Actions, Cargo, npm, Go modules, Gradle, NuGet, and Dockerfile managers.",
      "dependencyReview": ".github/dependency-review-config.yml fails high severity dependency review findings."
    },
    "versioning": {
      "repo": "Git tags and release workflows are the repository version source of truth.",
      "modelAndPackages": "Package manifests must carry explicit versions and release evidence must bind package versions to source commit/tag/checksum."
    }
  },
  "surfaces": [
