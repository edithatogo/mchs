{
  "name": "mchs",
  "display_name": "MCHS Health Services Microcosting",
  "version": "0.2.2",
  "description": "Synthetic-data-safe MCP tools for Australian health-services microcosting, NWAU pricing, and validation workflows.",
  "author": {
    "name": "edithatogo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/edithatogo/mchs.git"
  },
  "homepage": "https://github.com/edithatogo/mchs",
  "documentation": "https://github.com/edithatogo/mchs/tree/master/contracts/mcp",
  "support": "https://github.com/edithatogo/mchs/issues",
  "server": {
    "type": "python",
    "entry_point": "nwau_py/mcp_server.py",
    "mcp_config": {
      "command": "python",
      "args": [
        "-m",
        "nwau_py.mcp_server"
      ],
      "env": {
        "PYTHONPATH": "${__dirname}:${__dirname}/excel_calculator/src"
      }
    }
  },
  "tools": [
    {
      "name": "mchs.list_calculators",
      "description": "List calculators available through the MCHS MCP boundary.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "year": {
            "type": "string"
          },
          "includeDeprecated": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "mchs.get_schema",
      "description": "Return a canonical schema for a calculator input or output.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "calculatorId"
        ],
        "properties": {
          "calculatorId": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "input",
              "output"
            ]
          }
        }
      }
    },
    {
      "name": "mchs.validate_input",
      "description": "Validate a calculator request at the MCP contract boundary.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "calculatorId",
          "year",
          "inputs"
        ],
        "properties": {
          "calculatorId": {
            "type": "string"
          },
          "year": {
            "type": "string"
          },
          "inputs": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "mchs.calculate",
      "description": "Validate and delegate a calculation request.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "calculatorId",
          "year",
          "inputs"
        ],
        "properties": {
          "calculatorId": {
            "type": "string"
          },
          "year": {
            "type": "string"
          },
          "inputs": {
            "type": "object"
          },
          "options": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "mchs.explain_result",
      "description": "Explain the MCP boundary steps for a calculation request.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "calculatorId",
          "year",
          "inputs"
        ],
        "properties": {
          "calculatorId": {
            "type": "string"
          },
          "year": {
            "type": "string"
          },
          "inputs": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "mchs.get_evidence",
      "description": "Return release and MCP registry evidence.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bundleId": {
            "type": "string"
          }
        }
      }
    }
  ],
  "tools_generated": false,
  "prompts": [],
  "prompts_generated": false,
  "keywords": [
    "mcp",
    "healthcare",
    "microcosting",
    "nwau",
    "pricing"
  ],
  "license": "MIT",
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "python": ">=3.10,<3.15"
    }
  }
}
