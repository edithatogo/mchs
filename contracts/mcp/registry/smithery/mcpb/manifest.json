{
  "manifest_version": "0.4",
  "name": "mchs",
  "display_name": "MCHS NWAU Calculator MCP",
  "version": "0.2.2",
  "description": "Synthetic-data-safe MCP tools for Australian health-services microcosting, NWAU pricing support-scope inspection, schema discovery, validation, and release evidence.",
  "author": {
    "name": "edithatogo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/edithatogo/mchs"
  },
  "homepage": "https://github.com/edithatogo/mchs",
  "support": "https://github.com/edithatogo/mchs/issues",
  "license": "MIT",
  "server": {
    "type": "python",
    "entry_point": "src/server.py",
    "mcp_config": {
      "command": "python",
      "args": [
        "${__dirname}/src/server.py"
      ],
      "env": {}
    }
  },
  "tools": [],
  "tools_generated": true,
  "prompts": [],
  "prompts_generated": false,
  "keywords": [
    "mcp",
    "healthcare",
    "microcosting",
    "nwau",
    "pricing",
    "validation"
  ],
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "python": ">=3.10,<3.15"
    }
  }
}
