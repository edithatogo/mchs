{
  "name": "@edithatogo/mchs-wasm-binding",
  "version": "0.1.0",
  "description": "TypeScript adapter for wasm-pack output; no calculator logic.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
