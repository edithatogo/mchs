# GitHub live-gate operator template
#
# This file is intentionally non-secret. GitHub Actions injects GITHUB_TOKEN and
# GH_TOKEN automatically at runtime, so nothing below should contain a real
# credential.
#
# Copy this file to docs/runbooks/github-live-gate.env and replace the placeholder
# values before running the bootstrap dispatch preflight.

# Workflow to dispatch or publish.
LIVE_GATE_WORKFLOW=publish.yml

# Release tag to use for manual dispatches and release publication.
LIVE_GATE_TAG=v0.0.0

# NSW operator details used for approvals and change tracking.
NSW_OPERATOR_NAME=NSW operator name
NSW_OPERATOR_EMAIL=operator@example.nsw.gov.au
NSW_APPROVER_NAME=NSW approver name
NSW_APPROVER_EMAIL=approver@example.nsw.gov.au

# Optional release context.
NSW_RELEASE_REASON=Manual live-gate dispatch for GitHub release or registry publication
NSW_RELEASE_NOTES=Document the evidence bundle, dispatch time, and approval reference here

# Built-in GitHub runtime tokens.
GITHUB_TOKEN=provided_by_github_actions
GH_TOKEN=provided_by_github_actions
